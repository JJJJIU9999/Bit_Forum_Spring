# Copy this file to .env before running Docker Compose locally.
# Do not commit your real .env file.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=bit_forum

SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=change-me

# Must be at least 32 bytes for HS256 signing.
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
JWT_EXPIRATION=604800000
